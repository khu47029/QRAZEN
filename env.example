# ─── Core (required in production) ────────────────────────────────────────────

# Local libSQL/SQLite file for development. Use a libsql:// URL for Turso in prod.
DATABASE_URL=file:./local.db

# Secret used to sign session cookies and viewer-session tokens (HMAC).
# MUST be set to a long random value in production — the code falls back to an
# insecure built-in default otherwise, which would let anyone forge sessions.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Public origin used to build the permanent QR resolver URL (/r/<token>) and
# links shown to users. No trailing slash. In production set your real domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Object storage (optional) ────────────────────────────────────────────────
# Leave these unset for local development: uploads are written to ./.local_storage
# and served through /api/serve. Set all three R2_* values to switch uploads to a
# Cloudflare R2 (S3-compatible) bucket.

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=qr-content-bucket
