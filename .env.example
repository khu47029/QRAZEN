# ─── Core (required in production) ────────────────────────────────────────────

# PostgreSQL connection string (Supabase / Neon / self-hosted Postgres)
# In production, use transaction pooler or direct connection with sslmode=require
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Secret used to sign viewer-session tokens (HMAC-SHA256).
# MUST be set to a long random value in production (minimum 32 characters).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Public canonical origin for SEO, sitemaps, JSON-LD, and OpenGraph.
# In development or preview, leave empty (falls back to https://qr-website-ivory.vercel.app).
# When custom domain is connected, set to: https://qrazen.com
NEXT_PUBLIC_SITE_URL=https://qr-website-ivory.vercel.app

# Public origin used to build the permanent QR resolver URL (/r/<token>) and
# links shown to users. No trailing slash. In production set your real domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Object storage (Supabase Storage) ─────────────────────────────────────────
# In development/test: If left unset, uploads fall back to ./.local_storage.
# In production: MUST be configured. The application fails fast if missing.
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qr-content-bucket

